{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miraco33.github.io/seasonal-event/events-v2.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "dataVersion",
    "publishedAt",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "dataVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "collectionStatus": {
      "type": "object",
      "required": [
        "status",
        "code"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "alert"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "unavailableSources": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "id",
        "title",
        "startAt",
        "endAt",
        "rewards",
        "sourceUrl",
        "lastVerifiedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "startAt": {
          "type": "string",
          "format": "date-time"
        },
        "endAt": {
          "type": "string",
          "format": "date-time"
        },
        "questName": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "questLevel": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647
        },
        "questNpc": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "questId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "location": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "territoryId",
            "mapId",
            "x",
            "y",
            "z"
          ],
          "properties": {
            "territoryId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "mapId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "displayX": {
              "type": [
                "number",
                "null"
              ]
            },
            "displayY": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "achievementId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "teleport": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "aetheryteId",
            "subIndex"
          ],
          "properties": {
            "aetheryteId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "subIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "additionalProperties": false
        },
        "rewards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "category",
              "description",
              "flags"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "lastVerifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "announcementUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
