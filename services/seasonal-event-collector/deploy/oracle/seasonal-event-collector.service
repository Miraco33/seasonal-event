[Unit]
Description=Collect and publish FFXIV seasonal-event data
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/opt/oracle-services/seasonal-event/services/seasonal-event-collector/deploy/oracle/.env
ConditionPathExists=/home/ubuntu/.ssh/seasonal-event-deploy

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
WorkingDirectory=/opt/oracle-services/seasonal-event/services/seasonal-event-collector/deploy/oracle
Environment=DEPLOY_KEY_PATH=/home/ubuntu/.ssh/seasonal-event-deploy
Environment=GITHUB_KNOWN_HOSTS_PATH=/home/ubuntu/.ssh/seasonal-event-known_hosts
ExecStart=/opt/oracle-services/seasonal-event/services/seasonal-event-collector/deploy/oracle/run-and-publish.sh
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
