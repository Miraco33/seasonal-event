# Match the account that runs run-and-publish.sh. Check with: id -u; id -g
COLLECTOR_UID=1000
COLLECTOR_GID=1000

# Publishing is deliberately limited to the bind-mounted staging directory.
PUBLISH_MODE=filesystem
OUTPUT_FILE=/app/output/events-v2.json
LEGACY_OUTPUT_FILE=/app/output/events.json
ALLOW_EMPTY_EVENTS=false

# Public sources and overrides come from the read-only, versioned
# config/collector.json bind mount. Existing environment values remain supported
# and take precedence, so an already deployed .env does not need an immediate edit.
SOURCE_URLS=
DISCOVERY_URLS=
CANDIDATE_URLS=
IGNORED_CANDIDATE_URLS=
DISCOVERY_ALLOWED_HOSTS=
DISCOVERY_LOOKBACK_DAYS=180
EVENT_ID_OVERRIDES={}
LOCATION_OVERRIDES={}
REWARD_OVERRIDES={}
COMPLETION_OVERRIDES={}
EVENT_METADATA_OVERRIDES={}

NETWORK_RETRY_ATTEMPTS=3
NETWORK_RETRY_DELAY_MS=1000
NEXT_EVENT_WARNING_HOURS=168

# The collector image includes free Tesseract and Chinese/English system models.
# Leave these blank for Linux defaults; do not use Windows paths in the container.
OCR_EXECUTABLE_PATH=
OCR_TESSDATA_DIR=
# Independent persistent bind mount, unaffected by per-run status staging.
# Persist only OCR results: 32 files, 2 MiB each, 32 MiB total.
# Cache/Compose resource limits are configured bounds, not measured host peaks.
OCR_CACHE_DIR=/app/ocr-cache
