<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LuminaDirectory Condition="'$(LuminaDirectory)' == ''">$(APPDATA)\XIVLauncher\addon\Hooks\dev</LuminaDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Lumina">
      <HintPath>$(LuminaDirectory)\Lumina.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(LuminaDirectory)\Lumina.Excel.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckExistingLumina" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(LuminaDirectory)\Lumina.dll') Or !Exists('$(LuminaDirectory)\Lumina.Excel.dll')" Text="Set LuminaDirectory to an existing compatible Dalamud development directory; this tool does not install dependencies." />
  </Target>
</Project>
