# filesystem is safe for local runs and dry-runs.
PUBLISH_MODE=filesystem
OUTPUT_FILE=/app/output/events.json
STATUS_OUTPUT_FILE=/app/output/status.json
CANDIDATE_OUTPUT_FILE=/app/output/candidates.json
PREVIEW_OUTPUT_FILE=/app/output/preview.json
COLLECTOR_CONFIG_FILE=/app/config/collector.json

# Versioned public sources and overrides live in config/collector.json. These
# optional comma-separated variables extend the corresponding versioned lists.
SOURCE_URLS=
DISCOVERY_URLS=
CANDIDATE_URLS=
IGNORED_CANDIDATE_URLS=
DISCOVERY_ALLOWED_HOSTS=
DISCOVERY_LOOKBACK_DAYS=30
EVENT_ID_OVERRIDES={}
NETWORK_RETRY_ATTEMPTS=3
NETWORK_RETRY_DELAY_MS=1000
NEXT_EVENT_WARNING_HOURS=168
# Optional for local runs that reuse an installed Chrome or Edge.
PLAYWRIGHT_EXECUTABLE_PATH=

# Empty results are blocked by default so a source-page change cannot erase the existing feed.
# Set to true only when publishing an empty feed is intentional.
ALLOW_EMPTY_EVENTS=false

# Backward-compatible environment overrides keyed by collector-generated event ids.
# Environment entries take precedence over config/collector.json entries.
# Example: {"seasonal-aae61e8dfaea":{"territoryId":128,"mapId":11,"x":-9.61439,"y":39.9998,"z":82.0985,"displayX":11.0,"displayY":12.8}}
LOCATION_OVERRIDES={}

# Verified item rewards keyed by event id, used when the official page exposes only images.
# Example: {"seasonal-aae61e8dfaea":[{"name":"迷你乌克·拉玛特","category":"宠物","description":"","flags":[]}]}
REWARD_OVERRIDES={}

# Verified quest, achievement, and optional teleport ids keyed by event id.
# Example: {"seasonal-aae61e8dfaea":{"questId":71046,"achievementId":3875}}
COMPLETION_OVERRIDES={}

# Only needed for PUBLISH_MODE=github.
GITHUB_TOKEN=
GITHUB_REPOSITORY=Miraco33/seasonal-event
GITHUB_BRANCH=main
GITHUB_PATH=data/seasonal-event/events.json
