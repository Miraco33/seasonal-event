{
  "name": "seasonal-event-collector",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "discover": "npm run build && node dist/index.js --discover-only",
    "start": "node dist/index.js",
    "test": "node --test dist/*.test.js",
    "audit:history": "npm run build && node scripts/audit-history.mjs",
    "audit:recent": "npm run build && node scripts/audit-history.mjs --since=2025 --strict"
  },
  "dependencies": {
    "playwright": "1.55.1"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  }
}
