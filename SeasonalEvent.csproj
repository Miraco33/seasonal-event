<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>seasonalevent</AssemblyName>
    <RootNamespace>SeasonalEvent</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="seasonalevent.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyToDevPlugins" AfterTargets="Build" Condition="'$(DevPluginsDir)' != ''">
    <PropertyGroup>
      <DevPluginOutDir>$(DevPluginsDir)\seasonalevent\</DevPluginOutDir>
    </PropertyGroup>
    <MakeDir Directories="$(DevPluginOutDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DevPluginOutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)seasonalevent.json" DestinationFolder="$(DevPluginOutDir)" SkipUnchangedFiles="true" />
    <Message Text="Copied to $(DevPluginOutDir)" Importance="high" />
  </Target>
</Project>
